# Development image for local Docker Compose
FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=development
ENV PRISMA_HIDE_UPDATE_MESSAGE=1
ARG DATABASE_URL=postgresql://postgres:postgres@db:5432/training_db
ENV DATABASE_URL=${DATABASE_URL}

COPY package*.json ./
RUN npm ci

# Keep prisma config + schema in image for prisma commands
COPY prisma ./prisma
COPY prisma.config.ts ./
COPY tsconfig.json ./
COPY entrypoint.dev.sh /app/entrypoint.dev.sh

RUN chmod +x /app/entrypoint.dev.sh

EXPOSE 3000

CMD ["/app/entrypoint.dev.sh"]
